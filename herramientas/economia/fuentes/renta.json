   "aeat_irpf_2024_majadahonda": "https://sede.agenciatributaria.gob.es/AEAT/Contenidos_Comunes/La_Agencia_Tributaria/Estadisticas/Publicaciones/sites/irpfmunicipios/2024/jrubik5c16ec2c5696fab67eb238255ee8fcb06c149d06.html"
